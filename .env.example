# ==============================================================================
# Environment Variables Example for Worker Attendance PWA
# Copy to .env for local overrides (never commit .env)
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance
POSTGRES_DB=attendance_db
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/attendance_db
SPRING_DATASOURCE_USERNAME=attendance
SPRING_DATASOURCE_PASSWORD=attendance

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Authentication (Google Sign-In & JWT)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=replace-with-a-secure-256-bit-secret-key-for-local-development-only
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# Email Delivery (Transactional HTTPS API: Resend, Brevo, or SES)
EMAIL_PROVIDER_API_KEY=your-email-provider-api-key
EMAIL_FROM_ADDRESS=reports@attendance.example.com
EMAIL_FROM_NAME="Attendance Reports"

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@attendance.example.com

# Frontend Vite variables
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

